# Local default: sqlite:///quiz_database.db
# Production: set DATABASE_URL to your PostgreSQL connection string.
DATABASE_URL=sqlite:///quiz_database.db
SECRET_KEY=replace-with-a-long-random-secret
TEACHER_USERNAME=admin
TEACHER_PASSWORD=change-this-password
EXAM_DURATION_MINUTES=45
QUESTIONS_PER_EXAM=50
# Optional: absolute path for SQLite when using a persistent mounted disk.
# SQLITE_PATH=/var/data/quiz_database.db
